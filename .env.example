# Groq API – erforderlich für OCR, Dokumentenerkennung, Chat, Recht-Check & Textgenerierung
# Key erstellen: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Optional: Speicherort der JSON-Datenbank überschreiben
# (auf Fly.io zeigt dies i.d.R. auf das gemountete Volume, siehe fly.toml)
# DATA_DIR=/data
