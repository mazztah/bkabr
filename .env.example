# Anthropic Claude API – erforderlich für Dokumentenerkennung, Chat, Recht-Check & Textgenerierung
# Key erstellen: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Modell überschreiben (Standard: claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: Speicherort der JSON-Datenbank überschreiben
# (auf Fly.io zeigt dies i.d.R. auf das gemountete Volume, siehe fly.toml)
# DATA_DIR=/data
